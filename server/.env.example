# 爱背诵后端配置

# 服务器配置
PORT=3000
NODE_ENV=development

# JWT密钥 (生产环境请更换)
JWT_SECRET=ai-recite-jwt-secret-key-2024
JWT_EXPIRES_IN=7d

# AI配置 (请填入你的API Key)
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# 或使用国内模型 (如智谱AI)
# ZHIPU_API_KEY=your-zhipu-api-key

# 数据库配置
DATABASE_PATH=./data/ai-recite.db

# 日志级别
LOG_LEVEL=info
